# -------------------------------------------------------
# HTTP 접속 시 HTTPS로 리다이렉션 + www 제거
# -------------------------------------------------------
RewriteEngine On

# www.jonsoft.co.kr → jonsoft.co.kr
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# http://jonsoft.co.kr → https://jonsoft.co.kr
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://jonsoft.co.kr%{REQUEST_URI} [L,R=301]